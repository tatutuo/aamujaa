# Kopioi tämä tiedosto nimelle .env ja täytä arvot.
# .env on .gitignoressa — älä koskaan committaa sitä.

# Palvelimen portti
PORT=3000

# Sallitut frontend-originit (pilkulla eroteltuna). Tyhjä = salli kaikki (vain kehityksessä).
CORS_ORIGINS=http://localhost:5173,https://d4nyyy.fi

# Palautelomakkeen sähköposti (Gmail: käytä sovellussalasanaa, ei tilin salasanaa)
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=

# Suojaa /api/nhl/admin/* -reitit. Jos tyhjä, admin-reitit ovat pois käytöstä.
ADMIN_TOKEN=

# Ennusteiden automaattiajo (klo 09:00 Suomen aikaa). false = pois päältä.
PREDICTIONS_ENABLED=true
